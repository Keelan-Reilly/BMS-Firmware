ENNOID-BMS-ToolV6.00.app/Contents/PkgInfo: 
	@test -d ENNOID-BMS-ToolV6.00.app/Contents || mkdir -p ENNOID-BMS-ToolV6.00.app/Contents
	@$(DEL_FILE) ENNOID-BMS-ToolV6.00.app/Contents/PkgInfo
	@echo "APPL????" > ENNOID-BMS-ToolV6.00.app/Contents/PkgInfo
ENNOID-BMS-ToolV6.00.app/Contents/Resources/empty.lproj: 
	@test -d ENNOID-BMS-ToolV6.00.app/Contents/Resources || mkdir -p ENNOID-BMS-ToolV6.00.app/Contents/Resources
	@touch ENNOID-BMS-ToolV6.00.app/Contents/Resources/empty.lproj
	
ENNOID-BMS-ToolV6.00.app/Contents/Info.plist: 
	@test -d ENNOID-BMS-ToolV6.00.app/Contents || mkdir -p ENNOID-BMS-ToolV6.00.app/Contents
	@$(DEL_FILE) ENNOID-BMS-ToolV6.00.app/Contents/Info.plist
	@sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.ENNOID-BMS-ToolV6.00,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.ENNOID-BMS-ToolV6.00,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},10.13,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,ENNOID-BMS-ToolV6.00,g" -e "s,@LIBRARY@,ENNOID-BMS-ToolV6.00,g" -e "s,\$${EXECUTABLE_NAME},ENNOID-BMS-ToolV6.00,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" macos/Info.plist >ENNOID-BMS-ToolV6.00.app/Contents/Info.plist

